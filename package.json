{
  "name": "zahra-zelita",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "i18next": "^25.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "^1.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^5.0.0-beta.7",
    "drizzle-kit": "^1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^5.0.0-beta.7",
    "vitest-mock-extended": "^5.1.1"
  }
}
