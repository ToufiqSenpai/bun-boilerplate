{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "oxlint": {
      "command": ["bun", "x", "oxlint", "--lsp"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".vue", ".astro", ".svelte"],
      "initialization": {
        "typeAware": true
      }
    },
    "typescript": {
      "command": ["bun", "x", "tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "mcp": {
    "infisical": {
      "type": "local",
      "command": ["bun", "x", "@infisical/mcp"],
      "enabled": true,
      "environment": {
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}",
        "INFISICAL_HOST_URL": "{env:INFISICAL_HOST_URL}"
      }
    }
  }
}
