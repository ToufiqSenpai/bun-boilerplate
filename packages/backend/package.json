{
  "name": "@bun-boilerplate/backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json && bun build --compile --sourcemap --asset ./.env --asset ./migrations ./src/main.ts --outfile ./dist/app",
    "test": "bun --bun vitest run",
    "test:e2e": "bun --bun vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "email:preview": "email dev --dir src/modules/auth/templates --port 3001"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@bun-boilerplate/i18n": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@infisical/sdk": "^5.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.1.0",
    "@sentry/bun": "^10.71.0",
    "@sentry/elysia": "^10.71.0",
    "@sindresorhus/slugify": "^3.0.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "negotiator": "1.1.0",
    "pino": "^10.3.1",
    "react-email": "^6.9.2",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@react-email/ui": "6.9.2",
    "@types/negotiator": "^0.6.5",
    "pino-pretty": "^13.1.3"
  }
}
