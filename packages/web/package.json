{
  "name": "@bun-boilerplate/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun dotenv -e .env.local -- bun --bun vite dev --port 3000",
    "generate-routes": "bun --bun tsr generate",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun --bun vite build",
    "package": "bun run build && bun scripts/package-exe.ts",
    "preview": "bun --bun vite preview",
    "test": "bun --bun vitest run",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bun-boilerplate/backend": "workspace:*",
    "@bun-boilerplate/i18n": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.1",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv-cli": "^11.0.0",
    "nitro": "3.0.260610-beta",
    "react-day-picker": "^10.0.1",
    "react-i18next": "^17.0.12",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-a11y": "^0.2.2",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@sentry/cli"
    ]
  }
}
